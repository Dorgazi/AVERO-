# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API). Publishable key only; RLS enforces access.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public site origin (used for metadata / absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments (server-only, not yet wired up; see docs/PAYMENTS.md)
PAYSTACK_SECRET_KEY=

# --- .env.test.local (separate file, gitignored) -------------------------
# TEST_OWNER_EMAIL=          owner account used by seed + owner tests
# TEST_OWNER_PASSWORD=
# TEST_SHOPPER_EMAIL=        optional non-owner account for access tests
# TEST_SHOPPER_PASSWORD=
# SEED_OWNER_EMAIL / SEED_OWNER_PASSWORD override TEST_OWNER_* for seeding
